# ============================================
# Kurrent Pipeline — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================

# --- Scraping ---
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# --- Enrichment ---
APOLLO_API_KEY=
PDL_API_KEY=

# --- AI ---
CLAUDE_API_KEY=

# --- Reports ---
PDFMONKEY_API_KEY=

# --- Database ---
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# --- Email ---
RESEND_API_KEY=

# --- Payments (future) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Error Tracking ---
SENTRY_DSN_PIPELINE=

# --- Auth / DB ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key — used by pipeline to read client configs (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# --- Ops ---
# Receives failure alerts and the run summary (defaults to a placeholder)
OPS_EMAIL=
# Set to "true" to run 1 role / 1 location / 1 result
TEST_MODE=
